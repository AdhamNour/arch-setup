{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/divergence.txt",
    "position": "top",
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "38;2;86;95;137",
      "2": "38;2;255;158;100",
      "3": "38;2;59;66;97"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;122;162;247",
      "title": "38;2;187;154;247"
    },
    "key": {
      "width": 15
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "key": " 󰯄"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;41;46;66m────────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "  os"
    },
    {
      "type": "kernel",
      "key": "  kernel"
    },
    {
      "type": "uptime",
      "key": "󰥔  uptime"
    },
    {
      "type": "packages",
      "key": "󰏖  packages"
    },
    {
      "type": "wm",
      "key": "  wm"
    },
    {
      "type": "terminal",
      "key": "  terminal"
    },
    {
      "type": "shell",
      "key": "  shell"
    },
    {
      "type": "cpu",
      "key": "  cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛  memory"
    },
    {
      "type": "disk",
      "key": "󰋊  disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "󰁹  battery"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;41;46;66m────────────────────────────────────────────"
    },
    {
      "type": "custom",
      "key": "󱪎  worldline",
      "format": "\u001b[38;2;255;158;100m1.048596%\u001b[38;2;86;95;137m  · El Psy Kongroo"
    },
    {
      "type": "colors",
      "paddingLeft": 15,
      "symbol": "circle"
    }
  ]
}