{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 16,
  "control-center-margin-right": 16,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 600,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No notifications on this worldline",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 5,
      "text": "Label Text"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "always",
      "blacklist": []
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "/home/adham/.config/swaync/scripts/wifi.sh toggle",
          "update-command": "/home/adham/.config/swaync/scripts/wifi.sh status"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "/home/adham/.config/swaync/scripts/bluetooth.sh toggle",
          "update-command": "/home/adham/.config/swaync/scripts/bluetooth.sh status"
        },
        {
          "label": "󰄄",
          "command": "sh -c 'swaync-client -cp; sleep 0.4; ~/.local/bin/screenshot area'"
        },
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp; loginctl lock-session'"
        },
        {
          "label": "󰐥",
          "command": "sh -c 'swaync-client -cp; wlogout -b 5 -p layer-shell'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "device": "amdgpu_bl2"
    }
  }
}