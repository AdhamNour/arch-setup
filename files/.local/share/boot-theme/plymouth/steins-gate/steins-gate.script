# Steins;Gate divergence meter for Plymouth.
# The tubes scramble, lock onto 1.048596 from left to right, then flicker now and then
# like real nixie tubes while the boot finishes.
#
# Deliberately uses only syntax that Plymouth's own example theme uses
# (/usr/share/plymouth/themes/script/script.script): no %, no "else if",
# no ++ outside for-loop headers, no number-to-string concatenation.

Window.SetBackgroundTopColor(0.102, 0.106, 0.149);     # #1a1b26 (solid: a gradient this subtle bands)
Window.SetBackgroundBottomColor(0.102, 0.106, 0.149);  # #1a1b26

#------------------------------------------ Images ------------------------------------------

digit[0] = Image("tube-0.png");
digit[1] = Image("tube-1.png");
digit[2] = Image("tube-2.png");
digit[3] = Image("tube-3.png");
digit[4] = Image("tube-4.png");
digit[5] = Image("tube-5.png");
digit[6] = Image("tube-6.png");
digit[7] = Image("tube-7.png");
digit[8] = Image("tube-8.png");
digit[9] = Image("tube-9.png");
dot = Image("tube-dot.png");
off = Image("tube-off.png");

# Final reading 1.048596 (-1 = the decimal point tube)
final[0] = 1;
final[1] = -1;
final[2] = 0;
final[3] = 4;
final[4] = 8;
final[5] = 5;
final[6] = 9;
final[7] = 6;

#------------------------------------------ Layout ------------------------------------------
# Tube images are 178x322: a 118x250 tube with a 30 px glow margin around it.

pitch = 140;
total = 7 * pitch + off.GetWidth();
x0 = Window.GetX() + Window.GetWidth() / 2 - total / 2;
y0 = Window.GetY() + Window.GetHeight() / 2 - off.GetHeight() / 2 - 60;

for (n = 0; n < 8; n++)
  {
    tube[n] = Sprite(off);
    tube[n].SetPosition(x0 + n * pitch, y0, 1);
    lock_at[n] = 45 + n * 11;    # frames at 50 fps: first tube locks at 0.9 s, last at 2.4 s
    locked[n] = 0;
    dim[n] = 0;
  }

base_image = Image("base.png");
base = Sprite(base_image);
# y0 + 274 puts the plate just under the tube bodies so the sockets sit on it
base.SetPosition(Window.GetX() + Window.GetWidth() / 2 - base_image.GetWidth() / 2, y0 + 274, 0);

caption_image = Image("caption.png");
caption = Sprite(caption_image);
caption.SetPosition(Window.GetX() + Window.GetWidth() / 2 - caption_image.GetWidth() / 2, y0 + off.GetHeight() + 50, 1);
caption.SetOpacity(0.9);

final_image = Image("caption-final.png");
final_caption = Sprite(final_image);
final_caption.SetPosition(Window.GetX() + Window.GetWidth() / 2 - final_image.GetWidth() / 2, y0 + off.GetHeight() + 90, 1);
final_caption.SetOpacity(0);

#----------------------------------------- Animation ----------------------------------------

frame = 0;
tick = 0;

fun random_digit ()
  {
    value = Math.Int(Math.Random() * 10);
    if (value > 9)
      value = 9;
    return value;
  }

fun show (index, value)
  {
    if (value < 0)
      tube[index].SetImage(dot);
    else
      tube[index].SetImage(digit[value]);
  }

fun refresh_callback ()
  {
    global.frame += 1;
    global.tick += 1;

    # scramble at ~17 Hz (every 3rd frame)
    scramble = 0;
    if (tick >= 3)
      {
        global.tick = 0;
        scramble = 1;
      }

    for (index = 0; index < 8; index++)
      {
        if (locked[index] == 0)
          {
            if (frame >= lock_at[index])
              {
                show(index, final[index]);
                locked[index] = 1;
              }
            else
              {
                if (scramble == 1)
                  {
                    if (Math.Random() < 0.08)
                      tube[index].SetImage(off);    # tube briefly dark
                    else
                      show(index, random_digit());
                  }
              }
          }
      }

    # fade in "STEINS GATE" over 0.5 s once the last tube has locked
    if (frame > lock_at[7])
      {
        if (frame <= lock_at[7] + 25)
          final_caption.SetOpacity((frame - lock_at[7]) / 25);
      }

    # afterwards, an occasional short nixie flicker on a random tube
    if (frame > lock_at[7] + 50)
      {
        for (index = 0; index < 8; index++)
          {
            if (dim[index] > 0)
              {
                dim[index] = dim[index] - 1;
                if (dim[index] == 0)
                  tube[index].SetOpacity(1);
              }
          }
        if (Math.Random() < 0.01)
          {
            pick = Math.Int(Math.Random() * 8);
            if (pick > 7)
              pick = 7;
            if (dim[pick] == 0)
              {
                tube[pick].SetOpacity(0.6);
                dim[pick] = 3;
              }
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

#------------------------------------ Password / messages -----------------------------------
# Only used if a disk is ever encrypted, or if systemd sends a message (e.g. during fsck).

prompt_sprite = Sprite();
prompt_sprite.SetPosition(0, y0 + off.GetHeight() + 150, 10);

fun display_password_callback (prompt, bullets)
  {
    stars = "";
    for (count = 0; count < bullets; count++)
      stars = stars + "*";
    prompt_image = Image.Text(prompt + "  " + stars, 0.75, 0.79, 0.96);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetOpacity(1);
  }

fun display_normal_callback ()
  {
    prompt_sprite.SetOpacity(0);
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message_sprite = Sprite();
message_sprite.SetPosition(0, Window.GetY() + Window.GetHeight() - 60, 10);

fun display_message_callback (text)
  {
    message_image = Image.Text(text, 0.34, 0.37, 0.54);
    message_sprite.SetImage(message_image);
    message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - message_image.GetWidth() / 2);
    message_sprite.SetOpacity(1);
  }

fun hide_message_callback (text)
  {
    message_sprite.SetOpacity(0);
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
